    # A real ORCID now exists and is used here. Background, kept because it
    # cost a failed archive attempt: Zenodo's CFF loader (zenodo-rdm's
    # AuthorSchema.validate_orcid) runs idutils.is_orcid() on this field,
    # which checksums it (ISO 7064 MOD 11-2). The placeholder
    # "0000-0000-0000-0000" fails that checksum and was the confirmed cause
    # of the "Citation metadata load failed" error on the v0.1.0 archive
    # attempt (traced directly in zenodo-rdm's source, not inferred).
    # Never put a placeholder back in this field.
    orcid: "https://orcid.org/0009-0004-9778-1161"
